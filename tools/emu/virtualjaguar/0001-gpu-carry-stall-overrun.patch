diff --git a/src/tom/gpu.c b/src/tom/gpu.c
index 2820480..fd6dccd 100644
--- a/src/tom/gpu.c
+++ b/src/tom/gpu.c
@@ -874,6 +874,16 @@ static void gpu_busy_account(uint32_t pc, uint32_t cyc, uint32_t ops)
 static int32_t gpuExecSliceBudget = 0;
 static int32_t gpuExecSliceRemaining = 0;
 
+/* RISC cycles a GPUExec() call overran its budget by: a bus or blitter
+ * stall charged near the end of the call takes `cycles` below zero.  The
+ * next call starts that much in debt instead of the overrun being dropped,
+ * so a stall costs the same whether it lands in a long call (the 68K is
+ * stopped or busy elsewhere) or a short one (the 68K is polling GPU RAM,
+ * and GPUSyncToM68K runs the GPU one sub-slice per 68K access).  Dropped,
+ * a polling 68K made blits nearly free.  It can be nonzero between
+ * retro_run() calls, so exact savestate replay needs it serialized. */
+static int32_t gpuCycleDebt = 0;
+
 void GPUReleaseTimeslice(void)
 {
 	gpu_releaseTimeSlice_flag = 1;
@@ -1632,6 +1642,7 @@ void GPUReset(void)
     * savestate boundary, so it is deliberately not serialized. */
    gpuSliceBudget        = 0;
    gpuSliceSpent         = 0;
+   gpuCycleDebt          = 0;
 
    gpu_reg = gpu_reg_bank_0;
    gpu_alternate_reg = gpu_reg_bank_1;
@@ -2647,6 +2658,8 @@ void GPUExec(int32_t cycles)
    gpu_releaseTimeSlice_flag = 0;
    gpu_in_exec++;
    gpuExecSliceBudget = cycles;
+   cycles -= gpuCycleDebt;
+   gpuCycleDebt = 0;
 
    pipeTiming = vjs.gpuPipelineTiming ? 1 : 0;
    riscScale  = riscClockScalePct;
@@ -2859,6 +2872,9 @@ void GPUExec(int32_t cycles)
          break;
    }
 
+   if (cycles < 0 && GPU_RUNNING)
+      gpuCycleDebt = -cycles;
+
    gpu_in_exec--;
 
    VJP_LEAVE(VJP_GPU);
