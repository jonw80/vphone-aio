 .extern _a_vde
 .extern _a_vdb
 .extern _debugscreenactive
 .extern _isrvmode
 .extern _sbartop
 .extern _sbar
 .extern _debugscreen
 .extern _screenshade
 .extern _readylist_p
 .extern _displaylist_p
 .extern _listbuffer
 .extern _listbuffers
 .extern _stopobj
 .extern _worklist
 .extern _lasttics
 .extern _lastticcount
 .extern _shadepixel
 .extern _workpage
 .extern _BASEORGY
 .extern _ticcount
 .extern _workingscreen
 .extern _viewpwidth
 .extern _viewxpos
 .extern _viewvmode
 .extern _frontendlist
 .extern _sbarscaled

	.phrase
	.68000
codeend:
