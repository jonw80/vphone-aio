 .long
 .dc.l	codeend - _ref9_start
_ref9_start::
 .gpu
	.org $f03100
DIVCONTROL		.equ	$f0211c

S_LE	.ccdef  $14     ; PL
U_LE	.ccdef  $04     ; CC
S_GT    .ccdef	$18   	; MI
U_GT    .ccdef	$08  	; CS

S_LT	.ccdef	$15		; PL+NE
U_LT	.ccdef	$05		; CC+NE

FP .equr r14
scratch .equr r10
scratch2 .equr r11
RETURNVALUE .equr r29
RETURNPOINT .equr r28
MATH_A .equr r27
MATH_B .equr r26
MATH_C .equr r25
MATH_RTS .equr r24
MATH_SIGN .equr r23

	movei	#codestart,scratch
	jump	T,(scratch)
	nop
	
	
GPU_IMUL:
 move MATH_A,MATH_SIGN
 xor MATH_B,MATH_SIGN
 abs MATH_A
 abs MATH_B
 move MATH_A,MATH_C
 mult MATH_B,MATH_C
 move MATH_B,scratch2
 shrq #16,scratch2
 mult MATH_A,scratch2
 shlq #16,scratch2
 add scratch2,MATH_C
 move MATH_A,scratch2
 shrq #16,scratch2
 mult MATH_B,scratch2
 shlq #16,scratch2
 add scratch2, MATH_C
 btst #31,MATH_SIGN
 jump EQ,(MATH_RTS)
 nop
 jump T,(MATH_RTS)
 neg MATH_C


	
codestart:
;====================
_R_Update::
;5 dag registers  4 register variables
;localoffset:0  regoffset:16  argoffset:16
;====================
 subq #16,FP

 movei #_worklist,r0
 load (r0),r0
 shlq #2,r0
 movei #_listbuffers,r1
 add r1,r0
 load (r0),r0
 move r0,r15 ;(worklist_p)
 move r15,r0 ;(worklist_p)
 movei #_listbuffer,r1
 sub r1,r0
 move r0,r18 ;(delta)
 move FP,r0
 addq #4,r0 ; &branch1
 movei #_a_vde,r1
 loadw (r1),r1
 movei #$ffff8000,scratch
 add scratch,r1
 xor scratch,r1
 movei #-3,r2
 sha r2,r1
 movei #32771,r3
 add r3,r1
 store r1,(r0)
 move FP,r0
 addq #8,r0 ; &branch2
 movei #_a_vdb,r1
 loadw (r1),r1
 movei #$ffff8000,scratch
 add scratch,r1
 xor scratch,r1
 sha r2,r1
 movei #16387,r2
 add r2,r1
 store r1,(r0)
 movei #_stopobj,r0
 sharq #3,r0
 move r0,r16 ;(link)
 move r16,r0 ;(link)
 shrq #8,r0
 store r0,(r15) ;(worklist_p)

 move r15,r0 ;(worklist_p)
 addq #4,r0
 move r16,r1 ;(link)
 shlq #24,r1
 load (FP+1),r2 ; local branch1
 add r2,r1
 store r1,(r0)

 moveq #8,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r16,r2 ;(link)
 sh r0,r2
 move r2,r0
 store r0,(r1)

 move r15,r0 ;(worklist_p)
 addq #12,r0
 move r16,r1 ;(link)
 shlq #24,r1
 load (FP+2),r2 ; local branch2
 add r2,r1
 store r1,(r0)

 movei #48,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r1,r0
 sub r18,r0 ;(delta)
 sharq #3,r0
 move r0,r16 ;(link)
 move r15,r0 ;(worklist_p)
 addq #16,r0
 move r16,r1 ;(link)
 shrq #8,r1
 store r1,(r0)

 move r15,r0 ;(worklist_p)
 addq #20,r0
 move r16,r1 ;(link)
 shlq #24,r1
 movei #16384,r2
 add r2,r1
 movei #3670016,r2
 add r2,r1
 movei #_BASEORGY,r2
 load (r2),r2
 movei #180,r3
 add r3,r2
 addq #1,r2
 shlq #4,r2
 add r2,r1
 addq #3,r1
 store r1,(r0)

 move r15,r0 ;(worklist_p)
 addq #24,r0
 move r16,r1 ;(link)
 shrq #8,r1
 store r1,(r0)

 move r15,r0 ;(worklist_p)
 addq #28,r0
 move r16,r1 ;(link)
 shlq #24,r1
 movei #32768,r2
 add r2,r1
 movei #3670016,r2
 add r2,r1
 movei #_BASEORGY,r2
 load (r2),r2
 movei #180,r3
 add r3,r2
 addq #1,r2
 shlq #4,r2
 add r2,r1
 addq #3,r1
 store r1,(r0)

 move r15,r0 ;(worklist_p)
 addq #32,r0
 moveq #0,r1
 store r1,(r0)

 movei #36,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 movei #_BASEORGY,r0
 load (r0),r0
 movei #180,r2
 add r2,r0
 addq #1,r0
 shlq #4,r0
 addq #2,r0
 store r0,(r1)

 movei #_stopobj,r0
 sharq #3,r0
 move r0,r16 ;(link)
 movei #40,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r16,r0 ;(link)
 shrq #8,r0
 store r0,(r1)

 movei #44,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r16,r0 ;(link)
 shlq #24,r0
 movei #36827,r2
 add r2,r0
 store r0,(r1)

 movei #_shadepixel,r0
 load (r0),r0
 moveq #0,r1
 cmp r0,r1
 movei #L52,scratch
 jump EQ,(scratch)
 nop

 movei #64,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r1,r0
 sub r18,r0 ;(delta)
 sharq #3,r0
 move r0,r16 ;(link)

 movei #L53,r0
 jump T,(r0)
 nop

L52:

 movei #96,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r1,r0
 sub r18,r0 ;(delta)
 sharq #3,r0
 move r0,r16 ;(link)

L53:

 movei #_viewpwidth,r0
 load (r0),r0
 move r0,r17 ;(pwidth)
 movei #48,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 movei #_workingscreen,r0
 load (r0),r0
 shlq #8,r0
 move r16,r2 ;(link)
 shrq #8,r2
 add r2,r0
 store r0,(r1)

 movei #52,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r16,r0 ;(link)
 shlq #24,r0
 movei #2949120,r2
 add r2,r0
 movei #_BASEORGY,r2
 load (r2),r2
 shlq #4,r2
 add r2,r0
 store r0,(r1)

 movei #56,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r17,r0 ;(pwidth)
 shrq #4,r0
 store r0,(r1)

 move FP,r0 ; &temp
 move r17,r1 ;(pwidth)
 shlq #28,r1
 move r17,r2 ;(pwidth)
 shlq #18,r2
 add r2,r1
 movei #32768,r2
 add r2,r1
 movei #16384,r2
 add r2,r1
 movei #_viewxpos,r2
 load (r2),r2
 add r2,r1
 store r1,(r0)
 movei #60,r1
 move r15,r2 ;(worklist_p)
 add r1,r2
 load (r0),r0
 store r0,(r2)

 movei #96,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r1,r0
 sub r18,r0 ;(delta)
 sharq #3,r0
 move r0,r16 ;(link)
 movei #64,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 movei #_screenshade,r0
 load (r0),r0
 shlq #8,r0
 move r16,r2 ;(link)
 shrq #8,r2
 add r2,r0
 store r0,(r1)

 movei #68,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r16,r0 ;(link)
 shlq #24,r0
 movei #2949120,r2
 add r2,r0
 movei #_BASEORGY,r2
 load (r2),r2
 shlq #4,r2
 add r2,r0
 store r0,(r1)

 movei #72,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r17,r0 ;(pwidth)
 shrq #4,r0
 movei #16384,r2
 add r2,r0
 store r0,(r1)

 movei #76,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r17,r0 ;(pwidth)
 shlq #28,r0
 movei #16384,r2
 add r2,r0
 movei #_viewxpos,r2
 load (r2),r2
 add r2,r0
 store r0,(r1)

;
; status bar background (96) and foreground (128): three phrase objects on
; 32 byte boundaries, so they can be scaled ones, which write each pixel
; twice when the view is 640 wide (_sbarscaled).  Then the debug screen
; (160).  jagonly.c's I_Update builds the same list.
;
SB_TOP	.equr	r5		; height, ypos, type
SB_W3	.equr	r6		; iwidth, dwidth, pitch, depth, xpos
SB_SBAR	.equr	r7		; sbar
SB_OBJ	.equr	r8		; the object being written

 movei #_sbar,SB_SBAR
 load (SB_SBAR),SB_SBAR
 move SB_SBAR,r0
 addq #2,r0
 loadw (r0),r0			; sbar->height
 shlq #14,r0
 movei #_BASEORGY,SB_TOP
 load (SB_TOP),SB_TOP
 movei #181,r1			; SCREENHEIGHT+1
 add r1,SB_TOP
 shlq #4,SB_TOP			; ypos
 add r0,SB_TOP
 movei #_sbarscaled,r0
 load (r0),r0
 add r0,SB_TOP			; bitmap type: 1 = scaled
 movei #$80A0B000,SB_W3	; iwidth 40, dwidth 40, pitch 1, 8 bpp, xpos 0

; background: links to the foreground
 movei #128,r0
 add r15,r0 ;(worklist_p)
 sub r18,r0 ;(delta)
 sharq #3,r0
 move r0,r16 ;(link)
 movei #96,SB_OBJ
 add r15,SB_OBJ
 move SB_SBAR,r0
 addq #16,r0			; sbar->data
 shlq #8,r0
 move r16,r1
 shrq #8,r1
 add r1,r0
 store r0,(SB_OBJ)
 addq #4,SB_OBJ
 move r16,r0
 shlq #24,r0
 add SB_TOP,r0
 store r0,(SB_OBJ)
 addq #4,SB_OBJ
 moveq #2,r0			; iwidth 40>>4
 store r0,(SB_OBJ)
 addq #4,SB_OBJ
 store SB_W3,(SB_OBJ)
 addq #4,SB_OBJ
 moveq #0,r0
 store r0,(SB_OBJ)
 addq #4,SB_OBJ
 movei #$2040,r0		; remainder 0, vscale 1.0, hscale 2.0 (if scaled)
 store r0,(SB_OBJ)

; foreground: links to the debug screen if it is up
 movei #_stopobj,r16
 sharq #3,r16 ;(link)
 movei #_debugscreenactive,r0
 load (r0),r0
 cmpq #0,r0
 jr EQ,sb_nodebug
 nop
 movei #160,r16
 add r15,r16 ;(worklist_p)
 sub r18,r16 ;(delta)
 sharq #3,r16 ;(link)
sb_nodebug:
 movei #128,SB_OBJ
 add r15,SB_OBJ
 movei #_sbartop,r0
 load (r0),r0
 shlq #8,r0
 move r16,r1
 shrq #8,r1
 add r1,r0
 store r0,(SB_OBJ)
 addq #4,SB_OBJ
 move r16,r0
 shlq #24,r0
 add SB_TOP,r0
 store r0,(SB_OBJ)
 addq #4,SB_OBJ
 movei #32770,r0		; transparent, iwidth 40>>4
 store r0,(SB_OBJ)
 addq #4,SB_OBJ
 store SB_W3,(SB_OBJ)
 addq #4,SB_OBJ
 moveq #0,r0
 store r0,(SB_OBJ)
 addq #4,SB_OBJ
 movei #$2040,r0
 store r0,(SB_OBJ)

 movei #_stopobj,r0
 sharq #3,r0
 move r0,r16 ;(link)
 moveq #4,r0
 move r0,r17 ;(pwidth)
 movei #160,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 movei #_debugscreen,r0
 load (r0),r0
 shlq #8,r0
 move r16,r2 ;(link)
 shrq #8,r2
 add r2,r0
 store r0,(r1)

 movei #164,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r16,r0 ;(link)
 shlq #24,r0
 movei #3538944,r2
 add r2,r0
 movei #_BASEORGY,r2
 load (r2),r2
 shlq #4,r2
 add r2,r0
 store r0,(r1)

 movei #168,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r17,r0 ;(pwidth)
 shrq #4,r0
 movei #39936,r2
 add r2,r0
 store r0,(r1)

 movei #172,r0
 move r15,r1 ;(worklist_p)
 add r0,r1
 move r17,r0 ;(pwidth)
 shlq #28,r0
 move r17,r2 ;(pwidth)
 shlq #18,r2
 add r2,r0
 movei #32768,r2
 add r2,r0
 addq #7,r0
 store r0,(r1)

;
; while (ticcount - lastticcount < 2) ;
;
; The 68000 is running the next game tic while we sit here, and the GPU
; outranks it on the bus.  Poll DRAM only every BUSIDLE local-RAM loops so
; the 68000 (and the last sprite blit) get the bus back.
;
BUSIDLE	.equ	64
 movei #_lastticcount,r1
 load (r1),r2				; lastticcount (only written below)
 movei #_ticcount,r3
 movei #L56,r4
 jr T,L57
 nop
L56:
 movei #BUSIDLE,r1
L56delay:
 subq #1,r1
 jr NE,L56delay
 nop
L57:
 load (r3),r0
 sub r2,r0
 moveq #2,r1
 cmp r0,r1
 jump S_LT,(r4)
 nop

 movei #_isrvmode,r0
 movei #_viewvmode,r1	; 0xc1 + (PWIDTH-1)<<9 for the detail setting
 load (r1),r1
 store r1,(r0)
 movei #_frontendlist,r0	; the view is up, not the 320 wide 8 bit page
 moveq #0,r1
 store r1,(r0)
 movei #_readylist_p,r0
 store r15,(r0) ;(worklist_p)

;
; while (displaylist_p != readylist_p) ;   (the vbl isr takes the new list)
; readylist_p == worklist_p, which we still hold in r15
;
 movei #_displaylist_p,r3
 movei #L59,r4
 jr T,L60
 nop
L59:
 movei #BUSIDLE,r1
L59delay:
 subq #1,r1
 jr NE,L59delay
 nop
L60:
 load (r3),r0
 cmp r0,r15 ;(worklist_p)
 jump NE,(r4)
 nop

 movei #_lasttics,r0
 movei #_ticcount,r1
 load (r1),r2
 movei #_lastticcount,r3
 load (r3),r4
 sub r4,r2
 store r2,(r0)
 load (r1),r0
 store r0,(r3)
 movei #_screenshade,r0
 load (r0),r0
 move r0,r1
 addq #4,r1
 movei #_shadepixel,r2
 load (r2),r2
 move r2,r3
 shlq #16,r3
 add r2,r3
 store r3,(r1)
 store r3,(r0)

 movei #_workpage,r0
 load (r0),r1
 moveq #1,r2
 xor r2,r1
 store r1,(r0)
 movei #_worklist,r0
 load (r0),r1
 xor r2,r1
 store r1,(r0)


L51:
 jump T,(RETURNPOINT)
 addq #16,FP ; delay slot

