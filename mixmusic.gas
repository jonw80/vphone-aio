;###########################################################################
;#  entry
;###########################################################################

;
; locals: (FP) return point, (FP+1) finalquad before mixing
;
mm_entry:
	subq	#8,FP
	store	RETURNPOINT,(FP)
	movei	#_finalquad,r0
	load	(r0),r0
	store	r0,(FP+1)

	movei	#x_MixSfx,r0
	movei	#mm_sfxdone,RETURNPOINT
	jump	T,(r0)
	nop
mm_sfxdone:

	movei	#_music,r0
	load	(r0),r0
	movei	#mm_done,scratch
	cmpq	#0,r0
	jump	EQ,(scratch)				; no song loaded
	nop

;
; start = the quad x_MixSfx started at (same rule it uses: never more than
; 512 quads behind finalquad), end = finalquad.  Both shifted one ring ahead.
;
	movei	#_finalquad,r0
	load	(r0),r1						; end quad
	load	(FP+1),r2					; start quad
	move	r1,r0
	sub		r2,r0						; end - start
	movei	#512,r3
	cmp		r0,r3
	jr		CC,mm_startok				; (unsigned) end - start <= 512
	nop
	move	r1,r2
	sub		r3,r2
mm_startok:
	movei	#4096,r3
	shlq	#3,r2
	shlq	#3,r1
	add		r3,r2						; r2 = music start time
	add		r3,r1						; r1 = music end time
	movei	#mm_endtime,r0
	store	r1,(r0)

;
; A new song (musictime == 0) starts at the window start.  If the music
; clock has fallen behind the window (sound was off, or a long stall),
; jump it forward and delay pending events by the same amount.
;
	movei	#_musictime,r4
	movei	#_next_eventtime,r5
	load	(r4),r0
	cmpq	#0,r0
	jr		NE,mm_notnew
	nop
	store	r2,(r4)
	movei	#mm_paint,scratch
	jump	T,(scratch)
	store	r2,(r5)						; delay slot
mm_notnew:
	move	r0,r3
	sub		r2,r3						; musictime - start
	jr		PL,mm_paint
	nop
	neg		r3							; how far behind
	load	(r5),r6
	store	r2,(r4)
	add		r3,r6
	store	r6,(r5)

mm_paint:
; never paint backwards (m_M_PaintMusic loops until musictime == end)
	load	(r4),r0
	sub		r0,r1						; end - musictime
	movei	#mm_done,scratch
	jump	MI,(scratch)
	nop
	jump	EQ,(scratch)
	nop
	movei	#m_M_PaintMusic,r0
	movei	#mm_done,RETURNPOINT
	jump	T,(r0)
	nop

mm_done:
	load	(FP),RETURNPOINT
	jump	T,(RETURNPOINT)
	addq	#8,FP						; delay slot

	.long
mm_endtime:	.dc.l	0

 .extern _samplecount
 .extern _sfxsample
 .extern _soundstarttics
 .extern _soundtics
 .extern _finalquad
 .extern _sfxchannels
 .extern _samples_per_midiclock
 .extern _music_end
 .extern _music_start
 .extern _music
 .extern _next_eventtime
 .extern _musictime
 .extern _music_channels
 .extern _instruments
 .extern _musicvolume

	.phrase
	.68000
codeend:
